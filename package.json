{
  "name": "base-node-ts",
  "version": "0.4.0",
  "description": "NodeJS base project with TypeScript for the rapid creation of backends with certain functionalities already created and programming patterns already defined.",
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --ignore-watch node_modules src/index.ts",
    "build": "tsc && tsc-alias",
    "seed": "node build/seed/run.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "check:ts": "npx tsc --noEmit",
    "prepare": "husky install",
    "format": "npx prettier --write .",
    "format-check": "npx prettier --check .",
    "generate-token-keys": "sh generate-token-keys.sh",
    "generate-token-keys:local": "sh generate-token-keys.sh local",
    "generate-credentials:local": "sh generate-environment-credentials.sh local",
    "generate-credentials:dev": "sh generate-environment-credentials.sh dev",
    "generate-credentials:qa": "sh generate-environment-credentials.sh qa",
    "generate-credentials:prod": "sh generate-environment-credentials.sh prod"
  },
  "keywords": [
    "mvc",
    "node",
    "nodejs",
    "typescript",
    "eslint",
    "prettier",
    "mongodb",
    "jsonwebtoken",
    "api versioning",
    "swagger documentation",
    "path alias",
    "mit"
  ],
  "author": {
    "name": "Luis Fernando Solano Martínez",
    "email": "luisfer.sm15@gmail.com",
    "url": "https://github.com/XxLuisFer15xX"
  },
  "license": "MIT",
  "dependencies": {
    "@types/nodemailer": "6.4.15",
    "bcrypt": "5.1.0",
    "cloudinary": "2.3.0",
    "cors": "2.8.5",
    "crypto": "1.0.1",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "google-auth-library": "9.11.0",
    "jsonwebtoken": "9.0.0",
    "mongoose": "7.3.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.14"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@types/bcrypt": "5.0.0",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "9.0.2",
    "@types/morgan": "1.9.4",
    "@types/multer": "1.4.11",
    "@typescript-eslint/eslint-plugin": "5.59.11",
    "eslint": "8.43.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-config-standard-with-typescript": "35.0.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-n": "15.7.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-promise": "6.1.1",
    "husky": "9.0.11",
    "prettier": "2.8.8",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.8.6",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.1.3"
  }
}
